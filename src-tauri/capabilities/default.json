{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissões completas para a Tasca do Vereda - Windows",
  "windows": ["main"],
  "platforms": ["windows"],
  "permissions": [
    "core:default",
    "core:webview:default",
    "shell:allow-open",
    "shell:default",
    "sql:default",
    "sql:allow-execute",
    "sql:allow-load",
    "sql:allow-select",
    "sql:allow-close",
    "fs:default",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "dialog:default"
  ]
}
