{
  "productName": "Rest-IA",
  "version": "1.0.7",
  "identifier": "ao.vereda.gestao.restaurante",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Rest-IA v1.0.7",
        "label": "main",
        "width": 1920,
        "height": 1080,
        "minWidth": 1024,
        "minHeight": 768,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "maximizable": true,
        "minimizable": true,
        "center": true,
        "alwaysOnTop": false,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "icon": [
      "icons/Square310x310Logo.png",
      "icons/Square150x150Logo.png",
      "icons/Square142x142Logo.png",
      "icons/Square107x107Logo.png",
      "icons/Square89x89Logo.png",
      "icons/Square71x71Logo.png",
      "icons/Square44x44Logo.png",
      "icons/Square30x30Logo.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Vereda Systems Angola",
    "category": "Business",
    "shortDescription": "Sistema POS para Gestão de Restaurante",
    "longDescription": "Tasca do Vereda POS é um sistema completo de gestão de restaurantes com interface responsiva, controle de estoque, gestão de funcionários e relatórios financeiros.",
    "windows": {
      "wix": {
        "language": "pt-PT"
      }
    }
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:tasca_vereda.db"]
    },
    "notification": {
      "all": true
    },
    "dialog": {
      "all": true
    },
    "shell": {
      "all": true,
      "open": true
    },
    "fs": {
      "all": true,
      "readFile": true,
      "writeFile": true,
      "readDir": true,
      "copyFile": true,
      "createDir": true,
      "removeDir": true,
      "removeFile": true,
      "renameFile": true
    }
  }
}