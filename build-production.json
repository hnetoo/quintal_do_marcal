{
  "name": "build-production",
  "version": "1.0.0",
  "description": "Script de build para produção do Tasca do Vereda POS",
  "scripts": {
    "build:frontend": "vite build",
    "build:tauri": "tauri build",
    "build:msi": "tauri build --target msi",
    "build:all": "npm run build:frontend && npm run build:msi",
    "build:dev": "vite build --mode development && tauri build --debug",
    "clean": "rimraf dist target src-tauri/target",
    "setup": "npm install && cd src-tauri && cargo build --release",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint src --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "eslint src --ext .ts,.tsx,.js,.jsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,css,md}\"",
    "type-check": "tsc --noEmit",
    "bundle-analyze": "npm run build:frontend && npx vite-bundle-analyzer dist/index.html",
    "optimize": "npm run build:frontend && npx vite optimize",
    "prepare-release": "npm run clean && npm run lint:fix && npm run format && npm run type-check && npm run build:all",
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:tauri\"",
    "dev:frontend": "vite",
    "dev:tauri": "tauri dev"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "concurrently": "^8.0.0",
    "eslint": "^8.0.0",
    "eslint-plugin-react": "^7.0.0",
    "eslint-plugin-react-hooks": "^4.0.0",
    "playwright": "^1.40.0",
    "prettier": "^3.0.0",
    "rimraf": "^5.0.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "vite-bundle-analyzer": "^0.7.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "volta": {
    "node": "18.19.0",
    "npm": "10.2.3"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie 11",
    "not op_mini all"
  ],
  "os": [
    "win32",
    "win64",
    "darwin",
    "linux"
  ],
  "cpu": [
    "x64",
    "arm64"
  ]
}
